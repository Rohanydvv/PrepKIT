# ==============================================================================
# PrepKIT - Environment Configuration
# ==============================================================================

# Server & Network Configuration
PORT=5000
NODE_ENV=development
ALLOW_LOCAL_URLS=true        # Set to 'true' in development/eval to allow localhost/127.0.0.1 crawler targets

# Database Configuration
# MongoDB connection URI (e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/prepkit?retryWrites=true&w=majority)
# When provided, PrepKIT connects to MongoDB Atlas for persistent cloud storage across container recycles.
# If left blank or unreachable, the application automatically falls back to an embedded local file datastore (data/db.json).
MONGODB_URI=

# Authentication Secret
# Secret key used for signing JWT authentication tokens
JWT_SECRET=super-secret-jwt-key-prepkit-prod-2026

# LLM Provider Configuration
# Supported providers: "gemini" (default), "groq", "openai", or "mock" (offline heuristic mode)
LLM_PROVIDER=gemini

# Google Gemini API Key (Recommended Free Tier - from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq API Key (Optional alternative free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API Key (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Client Configuration (For Next.js frontend if deployed separately)
NEXT_PUBLIC_API_URL=http://localhost:5000
