# ==============================================================================
# The AI Interview Prep Kit - Environment Configuration
# Assessment ID: FS-AI-INTERVIEW-01 (Trao)
# ==============================================================================

# Server & Network Configuration
PORT=5000
NODE_ENV=development
ALLOW_LOCAL_URLS=true        # Set to 'true' in development/eval to allow localhost/127.0.0.1 crawler targets

# Database Configuration
# MongoDB connection URI (e.g. mongodb://localhost:27017/interview_prep or MongoDB Atlas URI)
# If left blank or unreachable, the application automatically falls back to an embedded local file datastore (zero setup required!)
MONGODB_URI=

# Authentication Secret
# Secret key used for signing JWT authentication tokens
JWT_SECRET=super-secret-jwt-key-trao-assessment-2026

# LLM Provider Configuration
# Supported providers: "gemini" (default), "groq", "openai", or "mock" (offline heuristic mode)
LLM_PROVIDER=gemini

# Google Gemini API Key (Recommended Free Tier - from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq API Key (Optional alternative free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API Key (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Client Configuration (For Next.js frontend if deployed separately)
NEXT_PUBLIC_API_URL=http://localhost:5000
