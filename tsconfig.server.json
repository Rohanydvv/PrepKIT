{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "src/core/**/*",
    "src/server/**/*",
    "src/cli/**/*"
  ],
  "exclude": [
    "node_modules",
    "src/app/**/*",
    "dist"
  ]
}
